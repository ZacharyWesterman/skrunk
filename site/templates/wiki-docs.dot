{{~ it.docs : doc }}
<div class="card expand {{? !it.toplevel }}border{{?}}" *hover="load_doc_body('{{= doc.id }}')">
	<div class="card-inner">
		<div class="actions">
			<button class="icon clickable" *click="delete_document('{{= doc.id }}', '{{= doc.parent }}')">
				<i class="fa-solid fa-trash fa-lg"></i>
			</button>

			<button class="icon clickable right">
				<i class="fa-solid fa-pencil fa-lg"></i>
			</button>
		</div>

		<span class="clickable" *toggles="expand-{{= doc.id }}">
			<i class="fa-solid fa-angles-down fa-lg" id="chevron-{{= doc.id }}"></i>
			&nbsp;
			<b>{{= doc.title }}</b>
		</span>

		<div class="expand-container" id="expand-{{= doc.id }}">
			<div>
				<div name="document-body" id="{{= doc.id }}"></div>
				<div id="child-docs-{{= doc.id }}" template="wiki-docs"></div>

				<!--
				<button class="icon border right tooltip" *click="new_document('{{= doc.id }}')">
					<i class="fa-solid fa-plus fa-xl"></i>
					<span class="tooltiptext t-left">
						Create child document
					</span>
				</button>
				-->
			</div>
		</div>

		<span class="suppress clickable" *toggles="expand-{{= doc.id }}" *chevron="chevron-{{= doc.id }}">
			Created by {{= doc.creator.username }} on {{= date.output(doc.created) }}
		</span>
	</div>
</div>
{{~}}
