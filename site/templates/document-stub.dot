<div class="card">
	<div>
		<div class="actions">
			{{? it.creator.username === api.username }}
				<button class="icon clickable tooltip" *click="delete_document('{{= it.id }}')">
					<i class="fa-solid fa-trash fa-lg"></i>
					<span class="tooltiptext t-float-right">Delete document</span>
				</button>

				{{? it.blob_id !== null }}
				<span class="tooltip right">
					<span class="tooltiptext t-float-left">Download</span>
					<button class="icon" *click="download_document('{{= it.id }}')">
						<i class="fa-solid fa-file-arrow-down fa-xl"></i>
					</button>
				</span>
				{{?}}

				{{? window.wopi.supported && it.blob_id !== null }}
				<span class="tooltip right">
					<span class="tooltiptext t-float-left">Open in new tab</span>
					<button class="icon clickable" *click="view_document_new_tab('{{= it.id }}')">
						<i class="fa-solid fa-arrow-up-right-from-square fa-lg"></i>
					</button>
				</span>
				{{?}}

				<span class="tooltip right">
					<span class="tooltiptext t-float-left">Edit {{? it.blob_id !== null }}title{{??}}document{{?}}</span>
					<button class="icon clickable" *click="edit_document('{{= it.id }}')">
						<i class="fa-solid fa-pencil fa-lg"></i>
					</button>
				</span>

				{{? it.creator.username === api.username }}
					<span class="tooltip right">
						<span class="tooltiptext t-float-left">Share</span>
						<button class="icon clickable" *click="share_document('{{= it.id }}')">
							<i class="fa-solid fa-share-nodes fa-lg"></i>
						</button>
					</span>
				{{?}}
			{{?}}

			{{? window.wopi.supported && it.creator.username !== api.username && it.blob_id !== null }}
				<button class="icon clickable tooltip" *click="view_document('{{= it.id }}')">
					<span class="tooltiptext t-float-left">View document</span>
					<i class="fa-solid fa-eye fa-lg"></i>
				</button>
			{{?}}
		</div>

		<div class="clickable" *click="view_document('{{= it.id }}')">
			<b>{{= it.title }}</b>
			<div class="suppress">
				{{? it.updated }}
					Edited by {{= it.updater.display_name }}{{? (it.updater.display_name.toLowerCase() !== it.updater.username.toLowerCase()) }} ({{= it.updater.username }}){{?}} on {{= date.output(it.updated) }}
				{{?}}
				{{? it.updater?.username !== it.creator.username }}
					{{? it.updater?.username }}<br>{{?}}
					Created by {{= it.creator.display_name }}{{? (it.creator.display_name.toLowerCase() !== it.creator.username.toLowerCase()) }} ({{= it.creator.username }}){{?}} on {{= date.output(it.created) }}
				{{?}}
			</div>

			{{? it.creator.username !== api.username }}
			<div class="emphasis">Shared with you.</div>
			{{?}}

			<span class="right suppress tooltip">
				<span class="tooltiptext t-float-left">
					{{? it.blob_id !== null }}Rich text{{??}}Markdown{{?}} document
				</span>
				<i class="fa-solid {{? it.blob_id !== null }}fa-file-word{{??}}fa-brands fa-markdown{{?}}"></i>
			</span>
		</div>

		<button class="icon tooltip" {{? it.creator.username === api.username }}*click="set_document_tags('{{=it.id}}')"{{?}}>
			<i class="fa-solid fa-tag fa-lg"></i>
			<span class="tooltiptext t-float-right">
				{{? it.creator.username === api.username }}
					Edit tags
				{{??}}
					Document tags
				{{?}}
			</span>
		</button>
		{{~it.tags : tag}}
			{{? it.creator.username === api.username }}
				<div class="tag clickable" *click="set_tag_editor_value('{{=tag}}')" >{{= tag }}</div>
			{{??}}
				<div class="tag">{{= tag }}</div>
			{{?}}
		{{~}}
	</div>
</div>
