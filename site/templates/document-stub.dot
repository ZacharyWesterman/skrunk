<div class="card">
	<div>
		{{? it.creator.username === api.username || has_perm('admin') }}
		<div class="actions">
			<button class="icon clickable" *click="delete_document('{{= it.id }}')">
				<i class="fa-solid fa-trash fa-lg {{? it.creator.username !== api.username }}suppress{{?}}"></i>
			</button>

			{{? !window.wopi.supported }}
			<button class="icon clickable right" *click="edit_document('{{= it.id }}')">
				<i class="fa-solid fa-pencil fa-lg {{? it.creator.username !== api.username }}suppress{{?}}"></i>
			</button>
			{{?}}
		</div>

		<div class="clickable" *click="view_document('{{= it.id }}')">
			<b>{{= it.title }}</b>
			<br>
			<span class="suppress">
				{{? it.updated }}
					Edited by {{= it.updater.username }} on {{= date.output(it.updated) }}
				{{?}}
				{{? it.updater?.username !== it.creator.username }}
					Created by {{= it.creator.username }} on {{= date.output(it.created) }}
				{{?}}
			</span>
		</div>
		{{?}}
	</div>
</div>
