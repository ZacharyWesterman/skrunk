{{~ it : item }}
<div class="card">
	<div>
		<i class="suppress">{{= date.output(item.created) }}</i>

		<button class="icon right" *click="delete_motd('{{= item.id }}')">
			<i class="fa-solid fa-trash fa-lg"></i>
		</button>

		<button class="icon right" *click="edit_motd('{{= item.id }}', '{{= safe_html(item.text) }}')">
			<i class="fa-solid fa-pencil fa-lg"></i>
		</button>

		<br>
		<br>

		<div style="text-align: center;">
			{{= item.text_html }}
		</div>
	</div>
</div>
{{~}}
